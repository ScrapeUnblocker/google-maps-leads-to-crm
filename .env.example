# Copy to .env for local runs (`cp .env.example .env`). Never commit .env.
# In GitHub Actions set these as repository secrets instead.

# Your ScrapeUnblocker API key: https://scrapeunblocker.com/?utm_source=github&utm_medium=integration&utm_campaign=example-repos
SCRAPEUNBLOCKER_KEY=your_key_here

# Set at least one destination. Unset ones are skipped.

# HubSpot: a service key (Development > Keys > Service keys) with the
# crm.objects.companies.read and crm.objects.companies.write scopes
HUBSPOT_TOKEN=

# Pipedrive: Personal preferences > API > Your personal API token
PIPEDRIVE_API_TOKEN=

# Airtable: a personal access token with data.records:read, data.records:write and
# schema.bases:read on your base. The base id can also go in config.yml.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# The digest of new leads (one message per run)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
LEADS_WEBHOOK_URL=
